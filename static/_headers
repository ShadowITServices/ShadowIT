# Cloudflare Pages reads this file from the build root. GitHub Pages ignores it
# (it is simply served as a static file), so it is safe to have in place before
# the cutover.
#
# Note: no Content-Security-Policy yet. Adding one here would need to account for
# Google Fonts and Microsoft Clarity; get it wrong and the site breaks silently
# in some browsers. Worth doing as a separate, tested change.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # HSTS without preload. Every shadowit.com.au subdomain must stay HTTPS-only
  # while this is set — which Cloudflare handles — but do not add `preload`
  # until you are certain, because preload lists are slow to back out of.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Hashed build assets are immutable — their filename changes when content does.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=86400
