# Cloudflare Pages redirects. GitHub Pages ignores this file, so it can sit here
# before the cutover without changing anything.
#
# These replace the meta-refresh stubs under static/services/, which exist only
# because GitHub Pages cannot issue a real 301. After the cutover is proven,
# delete static/services/ and these rules take over as proper 301s.
#
# Pages matches these paths case-sensitively, which is what finally lets the
# lower-case /study/az-104 spelling redirect to the real page — that was not
# possible on GitHub Pages, where a static stub would have collided with the
# route on a case-insensitive filesystem.

/services              /about/             301
/services/             /about/             301
/services/licensing    /tools/licensing/   301
/services/licensing/   /tools/licensing/   301

/study/az-104          /study/AZ-104/      301
/study/az-104/         /study/AZ-104/      301

# The Entra enterprise-applications sub-folder was flattened so every script
# sits directly under its workload. The workload URLs themselves are unchanged
# (they became folder index pages at the same path).
/docs/script-repository/microsoft-365/entra/enterprise-applications/auditing-stale-enterprise-applications    /docs/script-repository/microsoft-365/entra/stale-enterprise-applications/   301
/docs/script-repository/microsoft-365/entra/enterprise-applications/auditing-stale-enterprise-applications/   /docs/script-repository/microsoft-365/entra/stale-enterprise-applications/   301
/docs/script-repository/microsoft-365/entra/enterprise-applications/*                                         /docs/script-repository/microsoft-365/entra/                                 301

# The SC-300 program was retired. Send its URLs to the study index rather than
# to AZ-104 — a different exam is not the page anyone was looking for.
/study/sc-300          /study/             301
/study/sc-300/         /study/             301

# The three audience sections moved beneath a new Executing Strategy parent.
# Splats keep the tier pages (/strategy, /tactical, /operational) working too.
/docs/business-owners               /docs/executing-strategy/business-owners/                   301
/docs/managed-service-providers     /docs/executing-strategy/managed-service-providers/         301
/docs/internal-it-teams             /docs/executing-strategy/internal-it-teams/                 301
/docs/business-owners/*             /docs/executing-strategy/business-owners/:splat             301
/docs/managed-service-providers/*   /docs/executing-strategy/managed-service-providers/:splat   301
/docs/internal-it-teams/*           /docs/executing-strategy/internal-it-teams/:splat           301

# The Technical Library was removed. Its baselines were reference material
# rather than anything unique, and its framing now lives in the Executing
# Strategy overview; the scripts it pointed at live in the Script Repository.
/docs/technical-library/mfa-entra-hardening*     /docs/script-repository/microsoft-365/entra/   301
/docs/technical-library/*                        /docs/executing-strategy/                      301
